# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Turso / libSQL) ---
# Get these from your Turso dashboard: https://turso.tech
TURSO_DATABASE_URL="libsql://<db-name>.<org>.turso.io"
TURSO_AUTH_TOKEN=

# --- Auth (Clerk) ---
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Admin bootstrap ---
# Comma-separated list of emails that get ADMIN role on registration
ADMIN_EMAILS=admin@example.com

# --- AI / OCR (Anthropic) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Cron auth (Vercel Cron -> /api/cron/remind) ---
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Email (Resend) ---
# https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL="MyMeadow <onboarding@resend.dev>"

# --- SMS (Textbelt) ---
# https://textbelt.com — optional, leave TEXTBELT_ENABLED=false to skip SMS entirely
TEXTBELT_ENABLED=false
TEXTBELT_API_KEY=

# --- File storage (Vercel Blob) ---
# Auto-injected by Vercel when Blob storage is attached to the project; set manually for local dev
BLOB_READ_WRITE_TOKEN=
