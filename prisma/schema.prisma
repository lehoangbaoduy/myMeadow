datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TENANT
}

enum Gender {
  MALE
  FEMALE
}

enum RotationType {
  TRASH_DISHES
  BATHROOM
}

model User {
  id                     Int                     @id @default(autoincrement())
  clerkId                String                  @unique
  role                   Role                    @default(TENANT)
  registrationComplete   Boolean                 @default(false)
  tenant                 Tenant?
  notifications          Notification[]
  announcementRecipients AnnouncementRecipient[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model Tenant {
  id                      Int                      @id @default(autoincrement())
  name                    String
  nickname                String?
  avatarData              Bytes?
  avatarMimeType          String?
  isActive                Boolean                  @default(true)
  deactivatedAt           DateTime?
  dob                     DateTime?
  gender                  Gender
  phone                   String?
  email                   String?
  roomNumber              String?
  notes                   String?
  utilityShare            Float                    @default(1)
  rentAmount              Float?
  userId                  Int                      @unique
  user                    User                     @relation(fields: [userId], references: [id])
  maintenanceRequests     MaintenanceRequest[]
  rentReminderLogs        RentReminderLog[]
  rotationUnits           RotationUnit[]
  rotationTeamMembers     RotationTeamMember[]
  personalInventoryLists  PersonalInventoryList[]
  personalInventoryListShares PersonalInventoryListShare[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model RotationTeam {
  id           Int                  @id @default(autoincrement())
  rotationType RotationType
  name         String?
  members      RotationTeamMember[]
  unit         RotationUnit?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model RotationTeamMember {
  id           Int          @id @default(autoincrement())
  teamId       Int
  team         RotationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rotationType RotationType
  tenantId     Int
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addedAt      DateTime     @default(now())

  @@unique([rotationType, tenantId])
  @@index([teamId])
}

/// The authoritative, ordered roster for a rotation type. Each slot is
/// EITHER a solo tenant OR a team (never both) — see rotation-core.ts for
/// the resolver that reads this to answer "who has position P on date D".
model RotationUnit {
  id           Int           @id @default(autoincrement())
  rotationType RotationType
  order        Int
  tenantId     Int?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teamId       Int?          @unique
  team         RotationTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trashAssignments    TrashAssignment[]
  dishesAssignments   DishesAssignment[]
  bathroomAssignments BathroomAssignment[]

  @@unique([rotationType, order])
  @@unique([rotationType, tenantId])
}

model RotationShift {
  id                Int          @id @default(autoincrement())
  rotationType      RotationType
  effectiveDate     DateTime
  offsetPositions   Int
  actorUserId       Int
  reason            String?
  previousUnitLabel String
  newUnitLabel      String
  createdAt         DateTime     @default(now())

  @@index([rotationType, effectiveDate])
}

/// Effective-dated override of which Thursdays are recycle weeks. The most
/// recent row with effectiveDate <= a given Thursday wins; weeks before any
/// recorded row fall back to the base parity rule (isRecycleWeek). Mirrors
/// RotationShift's "don't touch history, only affect dates >= effectiveDate"
/// design, but stores an absolute hasRecycle value instead of an offset.
model RecycleShift {
  id            Int      @id @default(autoincrement())
  effectiveDate DateTime
  hasRecycle    Boolean
  actorUserId   Int
  reason        String?
  createdAt     DateTime @default(now())

  @@index([effectiveDate])
}

model UtilityBill {
  id            Int      @id @default(autoincrement())
  month         Int
  year          Int
  electric      Float    @default(0)
  electricUsage Float?
  electricPrice Float?
  gas           Float    @default(0)
  gasUsage      Float?
  gasPrice      Float?
  water         Float    @default(0)
  waterUsage    Float?
  waterPrice    Float?
  wifi          Float    @default(0)
  wifiPrice     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, year])
}

model UtilityDocument {
  id            Int       @id @default(autoincrement())
  month         Int
  year          Int
  utilityType   String
  fileName      String
  filePath      String
  billStartDate DateTime?
  billEndDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([month, year, utilityType])
}

model MaintenanceRequest {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  name             String
  requestType      String
  description      String
  status           String    @default("PENDING")
  resolvedByUserId Int?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TrashAssignment {
  id                Int           @id @default(autoincrement())
  date              DateTime
  unitId            Int?
  unit              RotationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  deletedUnitLabel  String?
  isRecycle         Boolean       @default(false)
  isOverride        Boolean       @default(false)
  status            String        @default("SCHEDULED")
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([date])
  @@index([unitId])
}

model DishesAssignment {
  id                Int           @id @default(autoincrement())
  date              DateTime
  unitId            Int?
  unit              RotationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  deletedUnitLabel  String?
  isOverride        Boolean       @default(false)
  status            String        @default("SCHEDULED")
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([date])
  @@index([unitId])
}

model BathroomAssignment {
  id                Int           @id @default(autoincrement())
  date              DateTime
  unitId            Int?
  unit              RotationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  deletedUnitLabel  String?
  isOverride        Boolean       @default(false)
  status            String        @default("SCHEDULED")
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([date])
  @@index([unitId])
}

model RentReminderLog {
  id       Int      @id @default(autoincrement())
  tenantId Int
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  month    Int
  year     Int
  sentAt   DateTime @default(now())

  @@unique([tenantId, month, year])
}

model Announcement {
  id              Int                     @id @default(autoincrement())
  title           String
  description     String
  date            DateTime
  createdByUserId Int?
  status          String                  @default("ACTIVE")
  expiresAt       DateTime?
  targetAll       Boolean                 @default(true)
  recipients      AnnouncementRecipient[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model AnnouncementRecipient {
  id              Int          @id @default(autoincrement())
  announcementId  Int
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clearedAt       DateTime?
  clearedByUserId Int?
  createdAt       DateTime     @default(now())

  @@unique([announcementId, userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  fromName  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InventoryItem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String
  icon      String?
  level     Float    @default(1.0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelLogs InventoryLevelLog[]
}

/// Attribution + history for restocks. Only logged when the level goes UP
/// (a restock) — dragging the level down or reporting a run-out is tracked
/// separately via InventoryRunOut and isn't "who filled it up".
model InventoryLevelLog {
  id              Int           @id @default(autoincrement())
  itemId          Int
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changedByUserId Int
  changedByName   String
  previousLevel   Float
  newLevel        Float
  createdAt       DateTime      @default(now())

  @@index([itemId, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model InventoryRunOut {
  id         Int      @id @default(autoincrement())
  itemName   String
  resolved   Boolean  @default(false)
  reportedAt DateTime @default(now())
}

/// A named grouping of personal inventory items, owned by one tenant.
/// Sharing happens at this level (see PersonalInventoryListShare) — an item
/// always belongs to exactly one list and inherits its list's visibility.
model PersonalInventoryList {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  PersonalInventoryItem[]
  shares PersonalInventoryListShare[]

  @@unique([tenantId, name])
}

model PersonalInventoryItem {
  id                Int                   @id @default(autoincrement())
  listId            Int
  list              PersonalInventoryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name              String
  quantity          Float?
  unit              String?
  category          String?
  description       String?
  expirationDate    DateTime?
  lowStockThreshold Float?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([listId, name])
}

/// Read-only visibility grant: the owner (tenant of the list) shares the
/// whole list — and everything currently or later added to it — with another
/// resident, who can view but not edit or delete. Ownership/write access
/// always stays with PersonalInventoryList.tenantId.
model PersonalInventoryListShare {
  id        Int                   @id @default(autoincrement())
  listId    Int
  list      PersonalInventoryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tenantId  Int
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())

  @@unique([listId, tenantId])
  @@index([tenantId])
}

/// A physical room. Assignment to a resident is read off Tenant.roomNumber
/// (matched by string, same field the Residents tab already writes) rather
/// than a foreign key, so both admin surfaces can edit it through the same
/// existing PUT /api/tenants/[id] route without a dual-write path.
model Room {
  id         Int         @id @default(autoincrement())
  roomNumber String      @unique
  notes      String?
  images     RoomImage[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model RoomImage {
  id            Int      @id @default(autoincrement())
  roomId        Int
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  imageData     Bytes
  imageMimeType String
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([roomId])
}
