datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TENANT
}

enum Gender {
  MALE
  FEMALE
}

enum RotationType {
  TRASH_DISHES
  BATHROOM
}

model User {
  id                     Int                     @id @default(autoincrement())
  clerkId                String                  @unique
  role                   Role                    @default(TENANT)
  registrationComplete   Boolean                 @default(false)
  tenant                 Tenant?
  notifications          Notification[]
  announcementRecipients AnnouncementRecipient[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model Tenant {
  id                      Int                      @id @default(autoincrement())
  name                    String
  nickname                String?
  avatarData              Bytes?
  avatarMimeType          String?
  isActive                Boolean                  @default(true)
  dob                     DateTime?
  gender                  Gender
  phone                   String?
  email                   String?
  roomNumber              String?
  notes                   String?
  utilityShare            Float                    @default(1)
  rentAmount              Float?
  userId                  Int                      @unique
  user                    User                     @relation(fields: [userId], references: [id])
  maintenanceRequests     MaintenanceRequest[]
  rentReminderLogs        RentReminderLog[]
  rotationUnits           RotationUnit[]
  rotationTeamMembers     RotationTeamMember[]
  personalInventoryItems  PersonalInventoryItem[]
  personalInventoryShares PersonalInventoryShare[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model RotationTeam {
  id           Int                  @id @default(autoincrement())
  rotationType RotationType
  name         String?
  members      RotationTeamMember[]
  unit         RotationUnit?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model RotationTeamMember {
  id           Int          @id @default(autoincrement())
  teamId       Int
  team         RotationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rotationType RotationType
  tenantId     Int
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addedAt      DateTime     @default(now())

  @@unique([rotationType, tenantId])
  @@index([teamId])
}

/// The authoritative, ordered roster for a rotation type. Each slot is
/// EITHER a solo tenant OR a team (never both) — see rotation-core.ts for
/// the resolver that reads this to answer "who has position P on date D".
model RotationUnit {
  id           Int           @id @default(autoincrement())
  rotationType RotationType
  order        Int
  tenantId     Int?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teamId       Int?          @unique
  team         RotationTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trashAssignments    TrashAssignment[]
  dishesAssignments   DishesAssignment[]
  bathroomAssignments BathroomAssignment[]

  @@unique([rotationType, order])
  @@unique([rotationType, tenantId])
}

model RotationShift {
  id                Int          @id @default(autoincrement())
  rotationType      RotationType
  effectiveDate     DateTime
  offsetPositions   Int
  actorUserId       Int
  reason            String?
  previousUnitLabel String
  newUnitLabel      String
  createdAt         DateTime     @default(now())

  @@index([rotationType, effectiveDate])
}

model UtilityBill {
  id            Int      @id @default(autoincrement())
  month         Int
  year          Int
  electric      Float    @default(0)
  electricUsage Float?
  electricPrice Float?
  gas           Float    @default(0)
  gasUsage      Float?
  gasPrice      Float?
  water         Float    @default(0)
  waterUsage    Float?
  waterPrice    Float?
  wifi          Float    @default(0)
  wifiPrice     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, year])
}

model UtilityDocument {
  id            Int       @id @default(autoincrement())
  month         Int
  year          Int
  utilityType   String
  fileName      String
  filePath      String
  billStartDate DateTime?
  billEndDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([month, year, utilityType])
}

model MaintenanceRequest {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  name             String
  requestType      String
  description      String
  status           String    @default("PENDING")
  resolvedByUserId Int?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TrashAssignment {
  id                Int           @id @default(autoincrement())
  date              DateTime
  unitId            Int?
  unit              RotationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  deletedUnitLabel  String?
  isRecycle         Boolean       @default(false)
  isOverride        Boolean       @default(false)
  status            String        @default("SCHEDULED")
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([date])
  @@index([unitId])
}

model DishesAssignment {
  id                Int           @id @default(autoincrement())
  date              DateTime
  unitId            Int?
  unit              RotationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  deletedUnitLabel  String?
  isOverride        Boolean       @default(false)
  status            String        @default("SCHEDULED")
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([date])
  @@index([unitId])
}

model BathroomAssignment {
  id                Int           @id @default(autoincrement())
  date              DateTime
  unitId            Int?
  unit              RotationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  deletedUnitLabel  String?
  isOverride        Boolean       @default(false)
  status            String        @default("SCHEDULED")
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([date])
  @@index([unitId])
}

model RentReminderLog {
  id       Int      @id @default(autoincrement())
  tenantId Int
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  month    Int
  year     Int
  sentAt   DateTime @default(now())

  @@unique([tenantId, month, year])
}

model Announcement {
  id              Int                     @id @default(autoincrement())
  title           String
  description     String
  date            DateTime
  createdByUserId Int?
  status          String                  @default("ACTIVE")
  expiresAt       DateTime?
  targetAll       Boolean                 @default(true)
  recipients      AnnouncementRecipient[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model AnnouncementRecipient {
  id              Int          @id @default(autoincrement())
  announcementId  Int
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clearedAt       DateTime?
  clearedByUserId Int?
  createdAt       DateTime     @default(now())

  @@unique([announcementId, userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  fromName  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InventoryItem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String
  icon      String?
  level     Float    @default(1.0)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model InventoryRunOut {
  id         Int      @id @default(autoincrement())
  itemName   String
  resolved   Boolean  @default(false)
  reportedAt DateTime @default(now())
}

model PersonalInventoryItem {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  quantity          Float?
  unit              String?
  category          String?
  description       String?
  expirationDate    DateTime?
  lowStockThreshold Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shares PersonalInventoryShare[]

  @@unique([tenantId, name])
}

/// Read-only visibility grant: the owner (tenant of the parent item) shares
/// an item with another resident, who can view but not edit or delete it.
/// Ownership/write access always stays with PersonalInventoryItem.tenantId.
model PersonalInventoryShare {
  id        Int                   @id @default(autoincrement())
  itemId    Int
  item      PersonalInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tenantId  Int
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())

  @@unique([itemId, tenantId])
  @@index([tenantId])
}
